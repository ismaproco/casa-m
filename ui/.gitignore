# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Prefer the repository-root .gitignore; this file covers ui/-relative paths for local tools.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
/dist/
/outputs/
/work/
/test-results/
/playwright-report/

# Local property image cache (large, reproducible, and intentionally untracked)
/public/property-images/
