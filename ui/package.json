{
  "name": "casa-mapa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "catalog:build": "node scripts/build-catalog.mjs",
    "rentals:build": "node scripts/build-rentals.mjs",
    "data:build": "npm run catalog:build && npm run rentals:build",
    "images:cache": "node scripts/cache-property-images.mjs",
    "build": "npm run data:build && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "npm run data:build && npm run test && npm run test:browser && npm run lint && npm run typecheck && vite build",
    "release": "npm run verify",
    "lint": "eslint . --ignore-pattern dist"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.26.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.15.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.0.13",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
